PORT=3000

# --- Loại CSDL: sqlite (ở nhà, không cần cài gì) hoặc mysql (ở trường) ---
DB_TYPE=sqlite
SQLITE_PATH=data/library.sqlite

# --- Chỉ dùng khi DB_TYPE=mysql ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=quan_ly_thu_vien

# true: TypeORM tự tạo/cập nhật bảng (chỉ dùng khi phát triển)
DB_SYNC=true

# Access token (ngắn hạn) và refresh token (dài hạn, lưu trong cookie httpOnly)
JWT_SECRET=doi_chuoi_bi_mat_nay_truoc_khi_deploy
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=doi_chuoi_bi_mat_khac_cho_refresh_token
JWT_REFRESH_DAYS=7
CORS_ORIGIN=*
